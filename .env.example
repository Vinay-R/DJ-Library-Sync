# Copy to .env, chmod 600 .env, then edit locally. Never paste secrets into chat.
SPOTIFY_CLIENT_ID=
SPOTIFY_REDIRECT_URI=http://127.0.0.1:8765/callback
TIDAL_CLIENT_ID=
TIDAL_CLIENT_SECRET=
